# Copiar a .env y completar. Nunca commitear el .env real.
# El CLI usa la publishable key (nunca la secret/service_role).

# Orden de carga: process.env > --env-file > ~/.sisyflow/.env > .env del paquete
# > apps/desktop/.env. Para el CLI instalado de forma global, la ubicación
# recomendada es ~/.sisyflow/.env (misma carpeta que la sesión).

# Supabase local (supabase start en backend/; puertos 453xx por restricciones de Windows)
SUPABASE_URL=http://127.0.0.1:45321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Producción (proyecto remoto sisyflow, us-east-1)
# SUPABASE_URL=https://djjttyejsbicmrvmgyep.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Si no se define aquí, el CLI reutiliza VITE_SUPABASE_URL y
# VITE_SUPABASE_PUBLISHABLE_KEY de apps/desktop/.env como fallback.

# Credenciales para scripts (opcional; también flags --email/--password)
# SISYFLOW_EMAIL=ana@example.com
# SISYFLOW_PASSWORD=password123